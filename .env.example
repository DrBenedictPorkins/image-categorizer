# Image Categorizer Environment Configuration
# Copy this file to .env.old and uncomment/configure the provider you want to use

# =============================================================================
# OLLAMA PROVIDER (Default - Local/Remote Ollama Server)
# =============================================================================
# Ollama is the default provider if no --provider is specified
# Configure these variables to use Ollama with vision models

# Ollama server host (required)
OLLAMA_HOST=http://localhost:11434

# Ollama model to use (required) 
OLLAMA_MODEL=llama3.2-vision:latest

# Request timeout in seconds (optional)
# OLLAMA_TIMEOUT=300

# =============================================================================
# ANTHROPIC PROVIDER (Claude API)
# =============================================================================
# To use Anthropic Claude, set your API key and optionally customize settings
# Get your API key from: https://console.anthropic.com/

# Anthropic API key (required for this provider)
# ANTHROPIC_API_KEY=your_api_key_here

# Claude model to use (optional)
# ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Maximum tokens in response (optional)
# ANTHROPIC_MAX_TOKENS=2000

# Response creativity/randomness 0.0-1.0 (optional)  
# ANTHROPIC_TEMPERATURE=0.2

# =============================================================================
# OPENAI PROVIDER (GPT API)
# =============================================================================
# To use OpenAI GPT models, set your API key and optionally customize settings
# Get your API key from: https://platform.openai.com/api-keys

# OpenAI API key (required for this provider)
# OPENAI_API_KEY=your_api_key_here

# GPT model to use (optional)
# OPENAI_MODEL=gpt-4o-mini

# Maximum tokens in response (optional)
# OPENAI_MAX_TOKENS=2000

# Response creativity/randomness 0.0-1.0 (optional)
# OPENAI_TEMPERATURE=0.2

# =============================================================================
# AWS BEDROCK PROVIDER (AWS Claude API)
# =============================================================================
# To use AWS Bedrock, configure your AWS credentials and optionally customize settings
# Requires AWS CLI configuration or IAM role with Bedrock access

# AWS credentials (both required for this provider)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# AWS region (optional)
# AWS_REGION=us-east-1

# Bedrock model ARN (optional)
# BEDROCK_MODEL=anthropic.claude-3-sonnet-20240229-v1:0

# =============================================================================
# USAGE EXAMPLES
# =============================================================================
# 
# Run with default provider (ollama):
#   python main.py /path/to/images
#
# Run with specific provider:
#   python main.py /path/to/images --provider anthropic
#   python main.py /path/to/images --provider openai
#   python main.py /path/to/images --provider bedrock
#
# Generate HTML from existing results:
#   python core/html_generator.py /path/to/results.json
#