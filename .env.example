# Image Categorizer configuration
# Copy to .env in the repository root. Values in .env override variables
# exported in the shell.

# =============================================================================
# OLLAMA (used by --provider ollama, --description-provider ollama,
# --categorization-provider ollama and --resort)
# =============================================================================

# Ollama server (required). Use the server's address if it runs on another machine.
OLLAMA_HOST=http://localhost:11434

# Vision model for Phase 1 descriptions (required; must have the vision capability)
OLLAMA_MODEL=qwen3.6:35b

# Text model for Phase 2 categorization, rule rewrites and re-sorts (required)
OLLAMA_TEXT_MODEL=mistral-small3.2:24b

# Request timeout in seconds, retries per request, base delay between retries
# OLLAMA_TIMEOUT=300
# OLLAMA_MAX_RETRIES=2
# OLLAMA_RETRY_DELAY=1.0

# =============================================================================
# CATEGORIES
# =============================================================================

# Saved category list reused across runs.
# Default: ~/.config/image-categorizer/categories.yaml
# Leave this unset while running the smoke test in SETUP.md.
# CATEGORIES_FILE=~/.config/image-categorizer/categories.yaml

# Upper bound on the number of categories (same as --max-categories). Default: no cap.
# MAX_CATEGORIES=12

# =============================================================================
# HUGGINGFACE (used by --provider huggingface; runs models in-process, no Ollama)
# =============================================================================

# HF_VISION_MODEL=Salesforce/blip2-flan-t5-xl-coco
# HF_TEXT_MODEL=google/flan-t5-xl
# HF_DEVICE=auto                  # auto, mps, cuda or cpu
# HF_CACHE_DIR=
# HUGGINGFACE_TOKEN=              # only for gated models
